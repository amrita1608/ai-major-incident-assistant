```json
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alert.schema.json",
  "title": "Alert",
  "description": "Schema for a monitoring or observability alert associated with an IT incident.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "alert_id",
    "timestamp",
    "source",
    "alert_name",
    "severity",
    "status",
    "service",
    "environment",
    "message"
  ],
  "properties": {
    "alert_id": {
      "type": "string",
      "description": "Unique identifier for the alert.",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Time when the alert was generated."
    },
    "source": {
      "type": "string",
      "description": "Monitoring or observability system that generated the alert.",
      "minLength": 1
    },
    "alert_name": {
      "type": "string",
      "description": "Name or title of the alert.",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "description": "Severity assigned to the alert.",
      "enum": [
        "critical",
        "high",
        "warning",
        "info"
      ]
    },
    "status": {
      "type": "string",
      "description": "Current state of the alert.",
      "enum": [
        "firing",
        "resolved"
      ]
    },
    "service": {
      "type": "string",
      "description": "Service or application associated with the alert.",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "description": "Environment where the alert was generated.",
      "enum": [
        "production",
        "staging",
        "development",
        "test"
      ]
    },
    "message": {
      "type": "string",
      "description": "Detailed alert message or observed condition.",
      "minLength": 1
    },
    "metric_name": {
      "type": [
        "string",
        "null"
      ],
      "description": "Name of the metric that triggered the alert."
    },
    "metric_value": {
      "type": [
        "number",
        "null"
      ],
      "description": "Metric value observed when the alert was triggered."
    },
    "threshold": {
      "type": [
        "number",
        "null"
      ],
      "description": "Threshold that was exceeded or violated."
    },
    "operator": {
      "type": [
        "string",
        "null"
      ],
      "description": "Comparison operator used to trigger the alert.",
      "enum": [
        "gt",
        "gte",
        "lt",
        "lte",
        "eq",
        "ne",
        null
      ]
    },
    "affected_component": {
      "type": [
        "string",
        "null"
      ],
      "description": "Specific infrastructure or application component associated with the alert."
    },
    "incident_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Incident identifier if the alert has already been associated with an incident."
    },
    "labels": {
      "type": "object",
      "description": "Additional searchable labels or tags from the monitoring system.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "runbook_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri",
      "description": "Optional URL to the operational runbook associated with the alert."
    },
    "metadata": {
      "type": "object",
      "description": "Additional non-sensitive alert metadata.",
      "additionalProperties": true
    }
  }
}
```
