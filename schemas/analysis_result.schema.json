```json
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analysis_result.schema.json",
  "title": "Incident Analysis Result",
  "description": "Schema for the structured output generated by the Incident AI Analyzer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "incident_id",
    "analysis_timestamp",
    "incident_summary",
    "symptom_analysis",
    "probable_root_cause",
    "workaround",
    "confidence",
    "evidence"
  ],
  "properties": {
    "incident_id": {
      "type": "string",
      "description": "Identifier of the incident that was analyzed.",
      "minLength": 1
    },

    "analysis_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the analysis was generated."
    },

    "incident_summary": {
      "type": "string",
      "description": "AI-generated concise summary of the incident and its impact.",
      "minLength": 1
    },

    "symptom_analysis": {
      "type": "object",
      "description": "Analysis of the symptoms observed during the incident.",
      "additionalProperties": false,
      "required": [
        "observed_symptoms",
        "matched_symptoms"
      ],
      "properties": {
        "observed_symptoms": {
          "type": "array",
          "description": "Symptoms identified from the incident, alerts, and logs.",
          "items": {
            "type": "string"
          }
        },
        "matched_symptoms": {
          "type": "array",
          "description": "Symptoms that matched known patterns in the knowledge base.",
          "items": {
            "type": "string"
          }
        },
        "unmatched_symptoms": {
          "type": "array",
          "description": "Symptoms for which no strong knowledge base match was found.",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },

    "probable_root_cause": {
      "type": "object",
      "description": "AI assessment of the most probable root cause.",
      "additionalProperties": false,
      "required": [
        "description",
        "confidence"
      ],
      "properties": {
        "description": {
          "type": "string",
          "description": "Description of the probable root cause.",
          "minLength": 1
        },
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "reasoning": {
          "type": "string",
          "description": "Evidence-based explanation for why this root cause is considered probable."
        },
        "alternative_causes": {
          "type": "array",
          "description": "Other possible root causes that should be considered.",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },

    "workaround": {
      "type": "object",
      "description": "Recommended mitigation or workaround for the incident.",
      "additionalProperties": false,
      "required": [
        "available",
        "description"
      ],
      "properties": {
        "available": {
          "type": "boolean",
          "description": "Whether a known or recommended workaround was identified."
        },
        "description": {
          "type": "string",
          "description": "Description of the recommended workaround or mitigation."
        },
        "source": {
          "type": [
            "string",
            "null"
          ],
          "description": "Source of the workaround, such as a KB article or runbook."
        },
        "risk": {
          "type": [
            "string",
            "null"
          ],
          "description": "Potential risk or limitation associated with applying the workaround."
        }
      }
    },

    "confidence": {
      "type": "object",
      "description": "Overall confidence in the generated analysis.",
      "additionalProperties": false,
      "required": [
        "level",
        "score"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence score between 0 and 1."
        },
        "explanation": {
          "type": "string",
          "description": "Explanation of why the analysis received this confidence level."
        }
      }
    },

    "evidence": {
      "type": "array",
      "description": "Evidence used to support the analysis.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "description"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "incident",
              "alert",
              "log",
              "kb_article"
            ]
          },
          "source_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Identifier of the evidence source."
          },
          "description": {
            "type": "string",
            "description": "Description of the relevant evidence.",
            "minLength": 1
          },
          "relevance": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "low",
              "medium",
              "high",
              null
            ]
          }
        }
      }
    },

    "matched_kb_articles": {
      "type": "array",
      "description": "Knowledge base articles that were considered relevant to the incident.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "article_id",
          "title",
          "match_score"
        ],
        "properties": {
          "article_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "match_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "matching_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "default": []
    },

    "recommended_next_steps": {
      "type": "array",
      "description": "Recommended actions for the incident response team.",
      "items": {
        "type": "string"
      },
      "default": []
    },

    "stakeholder_communication": {
      "type": "object",
      "description": "Draft communication that can be sent to incident stakeholders.",
      "additionalProperties": false,
      "properties": {
        "subject": {
          "type": "string"
        },
        "body": {
          "type": "string"
        }
      }
    },

    "limitations": {
      "type": "array",
      "description": "Important limitations, missing information, or uncertainties in the analysis.",
      "items": {
        "type": "string"
      },
      "default": []
    },

    "metadata": {
      "type": "object",
      "description": "Additional non-sensitive metadata about the analysis.",
      "additionalProperties": true
    }
  }
}
```
